    "pages:preview": "npx serve pages-dist -l 4173",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  },
  "devDependencies": {
    "@nuxt/test-utils": "latest",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "latest",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "latest",
    "happy-dom": "latest",
    "nuxt": "^4.6.3",
    "typescript": "~5.9.3",
    "vitest": "latest",
    "vue": "latest",
    "vue-component-meta": "^3.3.13",
    "vue-tsc": "latest"
  }
