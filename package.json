  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev .playground",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "prepare": "nuxt prepare .playground",
    "typecheck": "nuxt typecheck .playground",
    "test": "vitest run",
    "docs:gen": "node scripts/gen-manifest.mjs",
    "docs:check": "node scripts/gen-manifest.mjs --check",
    "site:dev": "nuxt dev site --port 3010",
